# OpenAI API Configuration
# Replace with your actual OpenAI API key (format: sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# Supported chat model (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_CHAT_MODEL=gpt-4o-mini

# Supported embedding model (e.g., text-embedding-3-small, text-embedding-ada-002)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
